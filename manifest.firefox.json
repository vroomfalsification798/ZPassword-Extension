{
  "manifest_version": 3,
  "name": "ZPassword",
  "version": "1.3.1",
  "description": "Generate a strong password the moment you open it, remember your rules per site, and fill it into the page in one click.",
  "browser_specific_settings": {
    "gecko": {
      "id": "zpassword@localhost",
      "strict_min_version": "115.0"
    }
  },
  "action": {
    "default_title": "ZPassword — generate a password",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "popup/popup.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "scripts": [
      "background/service-worker.js"
    ],
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "alarms"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open ZPassword"
    },
    "generate-and-fill": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Generate a password and fill it into the page"
    }
  }
}
